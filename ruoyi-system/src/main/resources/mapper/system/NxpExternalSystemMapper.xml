<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpExternalSystemMapper">
    
    <resultMap type="NxpExternalSystem" id="NxpExternalSystemResult">
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="id"    column="id"    />
    </resultMap>

    <sql id="selectNxpExternalSystemVo">
        select name, status, create_time, update_time, id from nxp_external_system
    </sql>

    <select id="selectNxpExternalSystemList" parameterType="NxpExternalSystem" resultMap="NxpExternalSystemResult">
        <include refid="selectNxpExternalSystemVo"/>
        <where>  
        </where>
    </select>
    
    <select id="selectNxpExternalSystemById" parameterType="Long" resultMap="NxpExternalSystemResult">
        <include refid="selectNxpExternalSystemVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpExternalSystem" parameterType="NxpExternalSystem" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_external_system
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateNxpExternalSystem" parameterType="NxpExternalSystem">
        update nxp_external_system
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpExternalSystemById" parameterType="Long">
        delete from nxp_external_system where id = #{id}
    </delete>

    <delete id="deleteNxpExternalSystemByIds" parameterType="String">
        delete from nxp_external_system where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>