<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpInspectionAboutReasonMapper">
    
    <resultMap type="NxpInspectionAboutReason" id="NxpInspectionAboutReasonResult">
        <result property="id"    column="id"    />
        <result property="aboutReasonName"    column="about_reason_name"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectNxpInspectionAboutReasonVo">
        select id, about_reason_name, create_time, update_time, remark,status from nxp_inspection_about_reason
    </sql>

    <select id="selectNxpInspectionAboutReasonList" parameterType="NxpInspectionAboutReason" resultMap="NxpInspectionAboutReasonResult">
        <include refid="selectNxpInspectionAboutReasonVo"/>
        <where>  
            <if test="aboutReasonName != null  and aboutReasonName != ''"> and about_reason_name like concat('%', #{aboutReasonName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectNxpInspectionAboutReasonById" parameterType="Long" resultMap="NxpInspectionAboutReasonResult">
        <include refid="selectNxpInspectionAboutReasonVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpInspectionAboutReason" parameterType="NxpInspectionAboutReason" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_inspection_about_reason
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="aboutReasonName != null">about_reason_name,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="aboutReasonName != null">#{aboutReasonName},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateNxpInspectionAboutReason" parameterType="NxpInspectionAboutReason">
        update nxp_inspection_about_reason
        <trim prefix="SET" suffixOverrides=",">
            <if test="aboutReasonName != null">about_reason_name = #{aboutReasonName},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpInspectionAboutReasonById" parameterType="Long">
        delete from nxp_inspection_about_reason where id = #{id}
    </delete>

    <delete id="deleteNxpInspectionAboutReasonByIds" parameterType="String">
        delete from nxp_inspection_about_reason where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>