<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpCheckListFileMapper">
    
    <resultMap type="NxpCheckListFile" id="NxpCheckListFileResult">
        <result property="id"    column="id"    />
        <result property="checkListId"    column="check_list_id"    />
        <result property="filePath"    column="file_path"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectNxpCheckListFileVo">
        select id, check_list_id, file_path, create_time from nxp_check_list_file
    </sql>

    <select id="selectNxpCheckListFileList" parameterType="NxpCheckListFile" resultMap="NxpCheckListFileResult">
        <include refid="selectNxpCheckListFileVo"/>
        <where>  
            <if test="checkListId != null "> and check_list_id = #{checkListId}</if>
            <if test="filePath != null  and filePath != ''"> and file_path = #{filePath}</if>
        </where>
    </select>
    
    <select id="selectNxpCheckListFileById" parameterType="Long" resultMap="NxpCheckListFileResult">
        <include refid="selectNxpCheckListFileVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpCheckListFile" parameterType="NxpCheckListFile" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_check_list_file
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="checkListId != null">check_list_id,</if>
            <if test="filePath != null">file_path,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="checkListId != null">#{checkListId},</if>
            <if test="filePath != null">#{filePath},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateNxpCheckListFile" parameterType="NxpCheckListFile">
        update nxp_check_list_file
        <trim prefix="SET" suffixOverrides=",">
            <if test="checkListId != null">check_list_id = #{checkListId},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpCheckListFileById" parameterType="Long">
        delete from nxp_check_list_file where id = #{id}
    </delete>

    <delete id="deleteNxpCheckListFileByIds" parameterType="String">
        delete from nxp_check_list_file where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>