<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpMachineProcessMapper">
    
    <resultMap type="NxpMachineProcess" id="NxpMachineProcessResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="owner"    column="owner"    />
        <result property="area"    column="area"    />
        <result property="create_dt"    column="createdt"    />
        <result property="update_dt"    column="updatedt"    />
    </resultMap>

    <sql id="selectNxpMachineProcessVo">
        select id, name, status, owner, createdt, updatedt,area from nxp_machine_process
    </sql>

    <select id="selectNxpMachineProcessList" parameterType="NxpMachineProcess" resultMap="NxpMachineProcessResult">
        <include refid="selectNxpMachineProcessVo"/>
        <where>  
            <if test="id != null  and id != ''"> and id = #{id}</if>
            <if test="name != null  and name != ''"> and name = #{name}</if>
            <if test="area != null  and name != ''"> and area = #{area}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="owner != null "> and owner = #{owner}</if>
            <if test="create_dt != null "> and createdt = #{create_dt}</if>
            <if test="update_dt != null "> and updatedt = #{update_dt}</if>
        </where>
    </select>
    
    <select id="selectNxpMachineProcessById" parameterType="Long" resultMap="NxpMachineProcessResult">
        <include refid="selectNxpMachineProcessVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpMachineProcess" parameterType="NxpMachineProcess" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_machine_process
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="owner != null">owner,</if>
            <if test="create_dt != null">createdt,</if>
            <if test="update_dt != null">updatedt,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="owner != null">#{owner},</if>
            <if test="create_dt != null">#{create_dt},</if>
            <if test="update_dt != null">#{update_dt},</if>
         </trim>
    </insert>

    <update id="updateNxpMachineProcess" parameterType="NxpMachineProcess">
        update nxp_machine_process
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="owner != null">owner = #{owner},</if>
            <if test="create_dt != null">createdt = #{create_dt},</if>
            <if test="update_dt != null">updatedt = #{update_dt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpMachineProcessById" parameterType="Long">
        delete from nxp_machine_process where id = #{id}
    </delete>

    <delete id="deleteNxpMachineProcessByIds" parameterType="String">
        delete from nxp_machine_process where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>