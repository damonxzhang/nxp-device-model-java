<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpMoldMaintenanceFileMapper">
    
    <resultMap type="NxpMoldMaintenanceFile" id="NxpMoldMaintenanceFileResult">
        <result property="id"    column="id"    />
        <result property="moldCheckId"    column="mold_check_id"    />
        <result property="moldMaintenanceId"    column="mold_maintenance_id"    />
        <result property="filePath"    column="file_path"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectNxpMoldMaintenanceFileVo">
        select id, mold_check_id, mold_maintenance_id, file_path, create_by, create_time, update_by, update_time, remark from nxp_mold_maintenance_file
    </sql>

    <select id="selectNxpMoldMaintenanceFileList" parameterType="NxpMoldMaintenanceFile" resultMap="NxpMoldMaintenanceFileResult">
        <include refid="selectNxpMoldMaintenanceFileVo"/>
        <where>  
            <if test="moldCheckId != null "> and mold_check_id = #{moldCheckId}</if>
            <if test="moldMaintenanceId != null "> and mold_maintenance_id = #{moldMaintenanceId}</if>
            <if test="filePath != null  and filePath != ''"> and file_path = #{filePath}</if>
        </where>
    </select>
    
    <select id="selectNxpMoldMaintenanceFileById" parameterType="Long" resultMap="NxpMoldMaintenanceFileResult">
        <include refid="selectNxpMoldMaintenanceFileVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpMoldMaintenanceFile" parameterType="NxpMoldMaintenanceFile" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_mold_maintenance_file
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="moldCheckId != null">mold_check_id,</if>
            <if test="moldMaintenanceId != null">mold_maintenance_id,</if>
            <if test="filePath != null">file_path,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="moldCheckId != null">#{moldCheckId},</if>
            <if test="moldMaintenanceId != null">#{moldMaintenanceId},</if>
            <if test="filePath != null">#{filePath},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateNxpMoldMaintenanceFile" parameterType="NxpMoldMaintenanceFile">
        update nxp_mold_maintenance_file
        <trim prefix="SET" suffixOverrides=",">
            <if test="moldCheckId != null">mold_check_id = #{moldCheckId},</if>
            <if test="moldMaintenanceId != null">mold_maintenance_id = #{moldMaintenanceId},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpMoldMaintenanceFileById" parameterType="Long">
        delete from nxp_mold_maintenance_file where id = #{id}
    </delete>

    <delete id="deleteNxpMoldMaintenanceFileByIds" parameterType="String">
        delete from nxp_mold_maintenance_file where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>