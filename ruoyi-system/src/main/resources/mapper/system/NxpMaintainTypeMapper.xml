<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpMaintainTypeMapper">
    
    <resultMap type="NxpMaintainType" id="NxpMaintainTypeResult">
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="create_user"    column="create_user"    />
        <result property="create_time"    column="create_time"    />
        <result property="update_time"    column="update_time"    />
        <result property="delete_time"    column="delete_time"    />
        <result property="id"    column="id"    />
        <result property="area"    column="area"    />
        <result property="process"    column="process"    />
    </resultMap>

    <sql id="selectNxpMaintainTypeVo">
        select name, status, create_user, create_time, update_time, delete_time, id, area, process from nxp_maintain_type
    </sql>

    <select id="selectNxpMaintainTypeList" parameterType="NxpMaintainType" resultMap="NxpMaintainTypeResult">
        <include refid="selectNxpMaintainTypeVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="create_user != null "> and create_user = #{create_user}</if>
            <if test="delete_time != null "> and delete_time = #{delete_time}</if>
            <if test="area != null "> and area = #{area}</if>
            <if test="process != null "> and process = #{process}</if>
        </where>
    </select>
    
    <select id="selectNxpMaintainTypeById" parameterType="Long" resultMap="NxpMaintainTypeResult">
        <include refid="selectNxpMaintainTypeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpMaintainType" parameterType="NxpMaintainType" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_maintain_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="create_user != null">create_user,</if>
            <if test="create_time != null">create_time,</if>
            <if test="update_time != null">update_time,</if>
            <if test="delete_time != null">delete_time,</if>
            <if test="area != null">area,</if>
            <if test="process != null">process,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="create_user != null">#{create_user},</if>
            <if test="create_time != null">#{create_time},</if>
            <if test="update_time != null">#{update_time},</if>
            <if test="delete_time != null">#{delete_time},</if>
            <if test="area != null">#{area},</if>
            <if test="process != null">#{process},</if>
         </trim>
    </insert>

    <update id="updateNxpMaintainType" parameterType="NxpMaintainType">
        update nxp_maintain_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="create_user != null">create_user = #{create_user},</if>
            <if test="create_time != null">create_time = #{create_time},</if>
            <if test="update_time != null">update_time = #{update_time},</if>
            <if test="delete_time != null">delete_time = #{delete_time},</if>
            <if test="area != null">area = #{area},</if>
            <if test="process != null">process = #{process},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpMaintainTypeById" parameterType="Long">
        delete from nxp_maintain_type where id = #{id}
    </delete>

    <delete id="deleteNxpMaintainTypeByIds" parameterType="String">
        delete from nxp_maintain_type where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>