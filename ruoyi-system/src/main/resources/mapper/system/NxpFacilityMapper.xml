    <sql id="selectNxpFacilityVo">
        select name, number,review_user, create_user, model, area, shift, serial_no, vendor_id, ASSET_NO, BUY_OFF_DATE, CBA_pass_date, head_user, status, is_ok, create_time, update_time, delete_time, id, process, relevant_people,inspection_status, is_replace from nxp_facility
