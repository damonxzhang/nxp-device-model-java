    </select>

    <select id="pendingInspection" parameterType="com.ruoyi.system.domain.NxpInspection" resultType="com.ruoyi.system.domain.DTO.NxpFacilityDTO">
        SELECT
            nf.name AS name,
            nf.number AS number,
            nf.status AS status,
            nf.is_ok AS is_ok,
            nui.chinese_name AS head_user,
            nf.id AS id,
            ni.status AS i_status,
            ni.repair_time AS i_repair_time,
            niqt.name AS i_question_type,
            ni.user_info_id AS user_info_id,
            nf.id AS inspection_id,
            ni.id AS i_id,
            nmp.name AS process,
            nmm.name AS model
        FROM
            nxp_inspection ni
            LEFT JOIN nxp_facility nf ON ni.facility_id = nf.id
            LEFT JOIN nxp_user_info nui ON nui.id = nf.head_user
            LEFT JOIN nxp_inspection_question_type niqt ON ni.question_type = niqt.id
            LEFT JOIN nxp_machine_process nmp ON nmp.id = nf.process
            LEFT JOIN nxp_machine_model nmm ON nmm.id = nf.model
        WHERE
            ni.id IN (
            SELECT --top 1
                ni.id AS niid
            FROM
                nxp_inspection ni
                LEFT JOIN nxp_facility_user nfu ON ni.facility_id = nfu.facility_id
            WHERE
                ( nfu.user_id = #{user_id} OR ni.user_info_id = #{user_id} )
                AND ni.status IN ( 0, 2, 3 )
            )
        ORDER BY
            ni.is_top ASC
    </select>

    <select id="selectFacilityList" parameterType="com.ruoyi.system.domain.NxpFacility" resultType="com.ruoyi.system.domain.DTO.NxpFacilityListDTO">
         SELECT
            nf.name AS name,
            nf.vendor_id AS vendor_id,
            nf.number AS number,
            nf.status AS status,
            nf.is_ok AS is_ok,
            nf.id AS id,
            nmp.name AS process,
            nf.inspection_status AS i_status,
            nui.chinese_name AS head_user
        FROM
            nxp_facility nf
            LEFT JOIN nxp_machine_process nmp ON nmp.id = nf.process
            LEFT JOIN nxp_user_info nui ON nui.id = nf.head_user
        <where>
            <if test="process != null and process != ''">
                AND nf.process = #{process}
            </if>
            <if test="status != null and status == 4">
                AND nf.inspection_status in (0,1,2,3)
            </if>
            <if test="status != null and status != '' and status != 4">
                AND nf.inspection_status = #{status}
            </if>
            <if test="name != null and name != ''">
                AND (nf.name like concat('%', #{name}, '%') or nf.number like concat('%', #{name}, '%'))
            </if>
            AND nf.status = 1

            AND nf.id IN (
                SELECT
                    nfu.facility_id
                FROM
                    nxp_facility_user nfu
                    LEFT JOIN nxp_inspection ni ON nfu.facility_id = ni.facility_id
                <where>
                    <if test="start_time != null and start_time != ''">
                        AND ni.created_at > #{start_time}
                    </if>
                    <if test="relation != null and relation != '' and relation != 1">
                        AND nfu.user_id = #{user_id}
                    </if>
                </where>
                GROUP BY
                    nfu.facility_id
            )
        </where>
        ORDER BY
            nf.number ASC
    </select>

