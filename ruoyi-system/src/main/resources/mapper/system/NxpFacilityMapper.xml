    <select id="selectNxpFacilityByNotInIds" parameterType="com.ruoyi.system.domain.VO.NxpFacilityVO" resultMap="NxpFacilityResult">
        <include refid="selectNxpFacilityVo"/>
        <where>
            <if test="ids != null and ids.size > 0">
                and id not in
                <foreach item="id" collection="ids" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
    </select>

    <select id="selectNxpFacilityByIds" parameterType="string" resultMap="NxpFacilityResult">
        <include refid="selectNxpFacilityVo"/>
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectNxpFacilityByNumber" parameterType="string" resultMap="NxpFacilityResult">
        select top 1 name, number,review_user, create_user, model, area, shift, serial_no, vendor_id, ASSET_NO, BUY_OFF_DATE, CBA_pass_date, head_user, status, is_ok, create_time, update_time, delete_time, id, process, relevant_people,inspection_status from nxp_facility
        where
        number = #{number} and status = 1
    </select>

    <select id="selectNxpFacilityAndProcessByNumber" parameterType="string" resultType="com.ruoyi.system.domain.NxpFacility">
        select nf.*,nmp.name as processName
        from nxp_facility nf
        LEFT JOIN nxp_machine_process nmp ON nmp.id = nf.process
        where
        nf.number = #{number} and nf.status = 1
    </select>

    <select id="selectNxpFacilityPmList" parameterType="NxpFacility" resultMap="NxpFacilityResult">
        SELECT
        nf.*,nip.status AS pm_status
        FROM
        nxp_facility nf
        LEFT JOIN nxp_inspection_pm nip ON nip.facility_id = nf.id
        <where>
            <if test="id != null"> and nf.id = #{id}</if>
            <if test="name != null  and name != ''"> and nf.name like concat('%', #{name}, '%')</if>
            <if test="number != null  and number != ''"> and nf.number = #{number}</if>
            <if test="model != null  and model != ''"> and nf.model = #{model}</if>
            <if test="area != null "> and nf.area = #{area}</if>
            <if test="shift != null "> and nf.shift = #{shift}</if>
            <if test="serial_no != null  and serial_no != ''"> and nf.serial_no = #{serial_no}</if>
            <if test="vendor_id != null "> and nf.vendor_id = #{vendor_id}</if>
            <if test="asset_no != null  and asset_no != ''"> and nf.ASSET_NO = #{asset_no}</if>
            <if test="buy_off_date != null "> and nf.BUY_OFF_DATE = #{buy_off_date}</if>
            <if test="cba_pass_date != null "> and nf.CBA_pass_date = #{cba_pass_date}</if>
            <if test="head_user != null "> and nf.head_user = #{head_user}</if>
            <if test="status != null "> and nf.status = #{status}</if>
            <if test="pm_status != null "> and nip.status = #{pm_status}</if>
            <if test="is_ok != null "> and nf.is_ok = #{is_ok}</if>
            <if test="delete_time != null "> and nf.delete_time = #{delete_time}</if>
            <if test="process != null  and process != ''"> and nf.process = #{process}</if>
            <if test="relevant_people != null  and relevant_people != ''"> and nf.relevant_people = #{relevant_people}</if>
            <if test="inspection_status != null  and inspection_status != ''"> and nf.inspection_status = #{inspection_status}</if>
        </where>
    </select>

    <select id="selectFacilityByModelAndProductTypeId" parameterType="NxpMold" resultMap="NxpFacilityResult">
        SELECT
        nf.*
        FROM
        nxp_facility nf
        LEFT JOIN nxp_facility_product_type nfpt ON nf.id = nfpt.facility_id
        LEFT JOIN nxp_machine_model nmm ON nf.model = nmm.id
        CROSS APPLY STRING_SPLIT (nfpt.product_type_id, ',') AS product_type_values
        <where>
            <if test="machineModel != null and machineModel != ''">AND nmm.id = #{machineModel}</if>
            <if test="productTypeId != null and productTypeId != ''">AND product_type_values.value = #{productTypeId}</if>
            AND product_type_values.value &lt;&gt; ''
        </where>
    </select>
