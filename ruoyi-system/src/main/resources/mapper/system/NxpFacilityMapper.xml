            <if test="vendor_id != null "> and vendor_id = #{vendor_id}</if>
            <if test="asset_no != null  and asset_no != ''"> and ASSET_NO = #{asset_no}</if>
            <if test="buy_off_date != null "> and BUY_OFF_DATE = #{buy_off_date}</if>
            <if test="cba_pass_date != null "> and CBA_pass_date = #{cba_pass_date}</if>
            <if test="head_user != null "> and head_user = #{head_user}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="is_ok != null "> and is_ok = #{is_ok}</if>
            <if test="delete_time != null "> and delete_time = #{delete_time}</if>
            <if test="process != null  and process != ''"> and process = #{process}</if>
            <if test="relevant_people != null  and relevant_people != ''"> and relevant_people = #{relevant_people}</if>
            <if test="inspection_status != null  and inspection_status != ''"> and inspection_status = #{inspection_status}</if>
