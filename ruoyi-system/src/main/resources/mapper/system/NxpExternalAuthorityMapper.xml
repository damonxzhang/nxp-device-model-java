<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpExternalAuthorityMapper">
    
    <resultMap type="NxpExternalAuthority" id="NxpExternalAuthorityResult">
        <result property="systemId"    column="system_id"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="id"    column="id"    />
    </resultMap>

    <sql id="selectNxpExternalAuthorityVo">
        select system_id, name, status, create_time, update_time, id from nxp_external_authority
    </sql>

    <select id="selectNxpExternalAuthorityList" parameterType="NxpExternalAuthority" resultMap="NxpExternalAuthorityResult">
        <include refid="selectNxpExternalAuthorityVo"/>
        <where>  
            <if test="systemId != null "> and system_id = #{systemId}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectNxpExternalAuthorityById" parameterType="Long" resultMap="NxpExternalAuthorityResult">
        <include refid="selectNxpExternalAuthorityVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpExternalAuthority" parameterType="NxpExternalAuthority" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_external_authority
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="systemId != null">system_id,</if>
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="systemId != null">#{systemId},</if>
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateNxpExternalAuthority" parameterType="NxpExternalAuthority">
        update nxp_external_authority
        <trim prefix="SET" suffixOverrides=",">
            <if test="systemId != null">system_id = #{systemId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpExternalAuthorityById" parameterType="Long">
        delete from nxp_external_authority where id = #{id}
    </delete>

    <delete id="deleteNxpExternalAuthorityByIds" parameterType="String">
        delete from nxp_external_authority where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>