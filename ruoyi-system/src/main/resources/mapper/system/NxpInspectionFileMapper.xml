<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpInspectionFileMapper">
    
    <resultMap type="NxpInspectionFile" id="NxpInspectionFileResult">
        <result property="id"    column="id"    />
        <result property="file_path"    column="file_path"    />
        <result property="create_time"    column="create_time"    />
    </resultMap>

    <sql id="selectNxpInspectionFileVo">
        select id, file_path, create_time from nxp_inspection_file
    </sql>

    <select id="selectNxpInspectionFileList" parameterType="NxpInspectionFile" resultMap="NxpInspectionFileResult">
        <include refid="selectNxpInspectionFileVo"/>
        <where>  
            <if test="file_path != null  and file_path != ''"> and file_path = #{file_path}</if>
        </where>
    </select>
    
    <select id="selectNxpInspectionFileById" parameterType="Long" resultMap="NxpInspectionFileResult">
        <include refid="selectNxpInspectionFileVo"/>
        where id = #{id}
    </select>

    <select id="selectNxpInspectionFileByIds" parameterType="String" resultMap="NxpInspectionFileResult">
        <include refid="selectNxpInspectionFileVo"/>
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <insert id="insertNxpInspectionFile" parameterType="NxpInspectionFile" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_inspection_file
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="file_path != null">file_path,</if>
            <if test="create_time != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="file_path != null">#{file_path},</if>
            <if test="create_time != null">#{create_time},</if>
         </trim>
    </insert>

    <update id="updateNxpInspectionFile" parameterType="NxpInspectionFile">
        update nxp_inspection_file
        <trim prefix="SET" suffixOverrides=",">
            <if test="file_path != null">file_path = #{file_path},</if>
            <if test="create_time != null">create_time = #{create_time},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpInspectionFileById" parameterType="Long">
        delete from nxp_inspection_file where id = #{id}
    </delete>

    <delete id="deleteNxpInspectionFileByIds" parameterType="String">
        delete from nxp_inspection_file where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectByBatchIds" resultMap="NxpInspectionFileResult" parameterType="String">
        <include refid="selectNxpInspectionFileVo"/>
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>