<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpExternalRelationMapper">
    
    <resultMap type="NxpExternalRelation" id="NxpExternalRelationResult">
        <result property="systemId"    column="system_id"    />
        <result property="authorityId"    column="authority_id"    />
        <result property="userId"    column="user_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
        <result property="id"    column="id"    />
    </resultMap>

    <sql id="selectNxpExternalRelationVo">
        select system_id, authority_id, user_id, status, id from nxp_external_relation
    </sql>

    <select id="selectNxpExternalRelationList" parameterType="NxpExternalRelation" resultMap="NxpExternalRelationResult">
        <include refid="selectNxpExternalRelationVo"/>
        <where>  
            <if test="systemId != null "> and system_id = #{systemId}</if>
            <if test="authorityId != null "> and authority_id = #{authorityId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectNxpExternalRelationById" parameterType="Long" resultMap="NxpExternalRelationResult">
        <include refid="selectNxpExternalRelationVo"/>
        where id = #{id}
    </select>
        

    <select id="selectNxpExternalRelationByUserId" parameterType="Long" resultMap="NxpExternalRelationResult">
        <include refid="selectNxpExternalRelationVo"/>
        where user_id = #{user_id} and system_id = 3
    </select>

    <insert id="insertNxpExternalRelation" parameterType="NxpExternalRelation" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_external_relation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="systemId != null">system_id,</if>
            <if test="authorityId != null">authority_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="systemId != null">#{systemId},</if>
            <if test="authorityId != null">#{authorityId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateNxpExternalRelation" parameterType="NxpExternalRelation">
        update nxp_external_relation
        <trim prefix="SET" suffixOverrides=",">
            <if test="systemId != null">system_id = #{systemId},</if>
            <if test="authorityId != null">authority_id = #{authorityId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpExternalRelationById" parameterType="Long">
        delete from nxp_external_relation where id = #{id}
    </delete>

    <delete id="deleteNxpExternalRelationByIds" parameterType="String">
        delete from nxp_external_relation where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>