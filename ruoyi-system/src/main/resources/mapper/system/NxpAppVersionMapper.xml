<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpAppVersionMapper">
    
    <resultMap type="NxpAppVersion" id="NxpAppVersionResult">
        <result property="id"    column="id"    />
        <result property="newVersionName"    column="new_version_name"    />
        <result property="newVersionNumber"    column="new_version_number"    />
        <result property="status"    column="status"    />
        <result property="content"    column="content"    />
        <result property="remark"    column="remark"    />
        <result property="downloadUrl"    column="download_url"    />
        <result property="forcedUpgrade"    column="forced_upgrade"    />
        <result property="upgrade"    column="upgrade"    />
        <result property="upgradeTime"    column="upgrade_time"    />
    </resultMap>

    <sql id="selectNxpAppVersionVo">
        select id,remark, new_version_name, new_version_number, status, content, download_url, forced_upgrade, upgrade, upgrade_time from nxp_app_version
    </sql>

    <select id="selectNxpAppVersionList" parameterType="NxpAppVersion" resultMap="NxpAppVersionResult">
        <include refid="selectNxpAppVersionVo"/>
        <where>  
            <if test="newVersionName != null  and newVersionName != ''"> and new_version_name like concat('%', #{newVersionName}, '%')</if>
            <if test="newVersionNumber != null "> and new_version_number = #{newVersionNumber}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="downloadUrl != null  and downloadUrl != ''"> and download_url = #{downloadUrl}</if>
            <if test="forcedUpgrade != null "> and forced_upgrade = #{forcedUpgrade}</if>
            <if test="upgrade != null "> and upgrade = #{upgrade}</if>
            <if test="upgradeTime != null "> and upgrade_time = #{upgradeTime}</if>
        </where>
    </select>
    
    <select id="selectNxpAppVersionById" parameterType="Long" resultMap="NxpAppVersionResult">
        <include refid="selectNxpAppVersionVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpAppVersion" parameterType="NxpAppVersion" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_app_version
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="newVersionName != null">new_version_name,</if>
            <if test="newVersionNumber != null">new_version_number,</if>
            <if test="status != null">status,</if>
            <if test="content != null">content,</if>
            <if test="remark != null">remark,</if>
            <if test="downloadUrl != null">download_url,</if>
            <if test="forcedUpgrade != null">forced_upgrade,</if>
            <if test="upgrade != null">upgrade,</if>
            <if test="upgradeTime != null">upgrade_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="newVersionName != null">#{newVersionName},</if>
            <if test="newVersionNumber != null">#{newVersionNumber},</if>
            <if test="status != null">#{status},</if>
            <if test="content != null">#{content},</if>
            <if test="remark != null">#{remark},</if>
            <if test="downloadUrl != null">#{downloadUrl},</if>
            <if test="forcedUpgrade != null">#{forcedUpgrade},</if>
            <if test="upgrade != null">#{upgrade},</if>
            <if test="upgradeTime != null">#{upgradeTime},</if>
         </trim>
    </insert>

    <update id="updateNxpAppVersion" parameterType="NxpAppVersion">
        update nxp_app_version
        <trim prefix="SET" suffixOverrides=",">
            <if test="newVersionName != null">new_version_name = #{newVersionName},</if>
            <if test="newVersionNumber != null">new_version_number = #{newVersionNumber},</if>
            <if test="status != null">status = #{status},</if>
            <if test="content != null">content = #{content},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="downloadUrl != null">download_url = #{downloadUrl},</if>
            <if test="forcedUpgrade != null">forced_upgrade = #{forcedUpgrade},</if>
            <if test="upgrade != null">upgrade = #{upgrade},</if>
            <if test="upgradeTime != null">upgrade_time = #{upgradeTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpAppVersionById" parameterType="Long">
        delete from nxp_app_version where id = #{id}
    </delete>

    <delete id="deleteNxpAppVersionByIds" parameterType="String">
        delete from nxp_app_version where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>