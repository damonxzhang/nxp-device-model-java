<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpMachineVendorMapper">
    
    <resultMap type="NxpMachineVendor" id="NxpMachineVendorResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectNxpMachineVendorVo">
        select id, name, status, create_time from nxp_machine_vendor
    </sql>

    <select id="selectNxpMachineVendorList" parameterType="NxpMachineVendor" resultMap="NxpMachineVendorResult">
        <include refid="selectNxpMachineVendorVo"/>
        <where>  
        </where>
        order by name asc
    </select>
    
    <select id="selectNxpMachineVendorById" parameterType="Long" resultMap="NxpMachineVendorResult">
        <include refid="selectNxpMachineVendorVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpMachineVendor" parameterType="NxpMachineVendor">
        insert into nxp_machine_vendor
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateNxpMachineVendor" parameterType="NxpMachineVendor">
        update nxp_machine_vendor
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpMachineVendorById" parameterType="Long">
        delete from nxp_machine_vendor where id = #{id}
    </delete>

    <delete id="deleteNxpMachineVendorByIds" parameterType="String">
        delete from nxp_machine_vendor where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>