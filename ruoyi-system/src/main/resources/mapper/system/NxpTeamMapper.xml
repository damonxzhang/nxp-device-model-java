<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpTeamMapper">
    
    <resultMap type="NxpTeam" id="NxpTeamResult">
        <result property="status"    column="status"    />
        <result property="teamName"    column="teamName"    />
        <result property="createdAt"    column="created_at"    />
        <result property="id"    column="id"    />
    </resultMap>

    <sql id="selectNxpTeamVo">
        select status, teamName, created_at, id from nxp_team
    </sql>

    <select id="selectNxpTeamList" parameterType="NxpTeam" resultMap="NxpTeamResult">
        <include refid="selectNxpTeamVo"/>
        <where>  
            <if test="status != null "> and status = #{status}</if>
            <if test="teamName != null  and teamName != ''"> and teamName like concat('%', #{teamName}, '%')</if>
        </where>
    </select>
    
    <select id="selectNxpTeamById" parameterType="Long" resultMap="NxpTeamResult">
        <include refid="selectNxpTeamVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpTeam" parameterType="NxpTeam" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_team
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="status != null">status,</if>
            <if test="teamName != null">teamName,</if>
            <if test="createdAt != null">created_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="status != null">#{status},</if>
            <if test="teamName != null">#{teamName},</if>
            <if test="createdAt != null">#{createdAt},</if>
         </trim>
    </insert>

    <update id="updateNxpTeam" parameterType="NxpTeam">
        update nxp_team
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="teamName != null">teamName = #{teamName},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpTeamById" parameterType="Long">
        delete from nxp_team where id = #{id}
    </delete>

    <delete id="deleteNxpTeamByIds" parameterType="String">
        delete from nxp_team where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>