<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpInspectionFeedbackMapper">
    
    <resultMap type="NxpInspectionFeedback" id="NxpInspectionFeedbackResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="feedback"    column="feedback"    />
        <result property="status"    column="status"    />
        <result property="created_at"    column="created_at"    />
    </resultMap>

    <sql id="selectNxpInspectionFeedbackVo">
        select id, user_id, feedback, status,created_at from nxp_inspection_feedback
    </sql>

    <select id="selectNxpInspectionFeedbackList" parameterType="NxpInspectionFeedback" resultMap="NxpInspectionFeedbackResult">
        select a.* from nxp_inspection_feedback a
        LEFT JOIN nxp_user_info b on a.user_id = b.id
        <where>  
            <if test="feedback != null  and feedback != ''"> and a.feedback = #{feedback}</if>
            <if test="status != null "> and a.status = #{status}</if>
            <if test="userShiftId != null "> and b.shift = #{userShiftId}</if>
            <if test="params.feedback_start_time != null and params.feedback_start_time != '' and params.feedback_end_time != null and params.feedback_end_time != ''">and created_at between #{params.feedback_start_time} and #{params.feedback_end_time}</if>

        </where>
    </select>
    
    <select id="selectNxpInspectionFeedbackById" parameterType="Long" resultMap="NxpInspectionFeedbackResult">
        <include refid="selectNxpInspectionFeedbackVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpInspectionFeedback" parameterType="NxpInspectionFeedback" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_inspection_feedback
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="feedback != null">feedback,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="feedback != null">#{feedback},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateNxpInspectionFeedback" parameterType="NxpInspectionFeedback">
        update nxp_inspection_feedback
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="feedback != null">feedback = #{feedback},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpInspectionFeedbackById" parameterType="Long">
        delete from nxp_inspection_feedback where id = #{id}
    </delete>

    <delete id="deleteNxpInspectionFeedbackByIds" parameterType="String">
        delete from nxp_inspection_feedback where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>