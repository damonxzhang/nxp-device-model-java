<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpMoldMaintenanceGroupMapper">
    
    <resultMap type="NxpMoldMaintenanceGroup" id="NxpMoldMaintenanceGroupResult">
        <result property="id"    column="id"    />
        <result property="groupName"    column="group_name"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="moldType"    column="mold_type"    />
    </resultMap>

    <resultMap id="NxpMoldMaintenanceGroupNxpMoldMaintenanceGroupItemResult" type="NxpMoldMaintenanceGroup" extends="NxpMoldMaintenanceGroupResult">
        <collection property="nxpMoldMaintenanceGroupItemList" notNullColumn="id" javaType="java.util.List" resultMap="NxpMoldMaintenanceGroupItemResult" />
    </resultMap>

    <resultMap type="NxpMoldMaintenanceGroupItem" id="NxpMoldMaintenanceGroupItemResult">
        <result property="groupItemId"    column="group_item_id"    />
        <result property="groupId"    column="group_id"    />
        <result property="itemName"    column="item_name"    />
        <result property="itemStatus"    column="item_status"    />
        <result property="isPhotograph"    column="is_photograph"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="moldTypeId"    column="mold_type_id"    />
        <result property="componentId"    column="component_id"    />
    </resultMap>

    <sql id="selectNxpMoldMaintenanceGroupVo">
        select id, group_name, status, create_by, create_time, update_by, update_time, remark, mold_type from nxp_mold_maintenance_group
    </sql>

    <select id="selectGroupItemById" parameterType="Long" resultMap="NxpMoldMaintenanceGroupItemResult">
        select
        group_item_id, group_id, item_name, item_status, is_photograph, create_by, create_time, update_by, update_time, remark
        from
        nxp_mold_maintenance_group_item
        where
        group_item_id = #{groupItemId}
    </select>

    <select id="selectNxpMoldMaintenanceGroupList" parameterType="NxpMoldMaintenanceGroup" resultMap="NxpMoldMaintenanceGroupResult">
        <include refid="selectNxpMoldMaintenanceGroupVo"/>
        <where>  
            <if test="groupName != null  and groupName != ''"> and group_name like concat('%', #{groupName}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="moldType != null "> and mold_type = #{moldType}</if>
        </where>
    </select>
    
    <select id="selectNxpMoldMaintenanceGroupById" parameterType="Long" resultMap="NxpMoldMaintenanceGroupNxpMoldMaintenanceGroupItemResult">
        select a.id, a.group_name, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark, a.mold_type,
            b.group_item_id, b.group_id, b.item_name, b.item_status, b.is_photograph, b.create_by, b.create_time, b.update_by, b.update_time, b.remark,b.mold_type_id,b.component_id
        from nxp_mold_maintenance_group a
        left join nxp_mold_maintenance_group_item b on b.group_id = a.id
        where a.id = #{id}
    </select>
        
    <insert id="insertNxpMoldMaintenanceGroup" parameterType="NxpMoldMaintenanceGroup" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_mold_maintenance_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupName != null">group_name,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="moldType != null">mold_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="groupName != null">#{groupName},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="moldType != null">#{moldType},</if>
         </trim>
    </insert>

    <update id="updateNxpMoldMaintenanceGroup" parameterType="NxpMoldMaintenanceGroup">
        update nxp_mold_maintenance_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="groupName != null">group_name = #{groupName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="moldType != null">mold_type = #{moldType},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpMoldMaintenanceGroupById" parameterType="Long">
        delete from nxp_mold_maintenance_group where id = #{id}
    </delete>

    <delete id="deleteNxpMoldMaintenanceGroupByIds" parameterType="String">
        delete from nxp_mold_maintenance_group where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteNxpMoldMaintenanceGroupItemByGroupIds" parameterType="String">
        delete from nxp_mold_maintenance_group_item where group_id in 
        <foreach item="groupId" collection="array" open="(" separator="," close=")">
            #{groupId}
        </foreach>
    </delete>

    <delete id="deleteNxpMoldMaintenanceGroupItemByGroupId" parameterType="Long">
        delete from nxp_mold_maintenance_group_item where group_id = #{groupId}
    </delete>

    <insert id="batchNxpMoldMaintenanceGroupItem">
        insert into nxp_mold_maintenance_group_item(group_id, item_name, item_status, is_photograph, create_by, create_time, update_by, update_time, remark) values
		<foreach item="item" index="index" collection="list" separator=",">
            (#{item.groupId}, #{item.itemName}, #{item.itemStatus}, #{item.isPhotograph}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark})
        </foreach>
    </insert>

    <select id="selectMoldTypeIdByGroupId" parameterType="long" resultType="long">
        SELECT
            mold_type_id
        FROM
            nxp_mold_maintenance_group_item
        WHERE
            group_id = #{groupId}
        GROUP BY
            mold_type_id
    </select>
</mapper>