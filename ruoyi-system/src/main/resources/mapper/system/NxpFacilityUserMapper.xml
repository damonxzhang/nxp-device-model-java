<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpFacilityUserMapper">
    
    <resultMap type="NxpFacilityUser" id="NxpFacilityUserResult">
        <result property="id"    column="id"    />
        <result property="facilityId"    column="facility_id"    />
        <result property="userId"    column="user_id"    />
    </resultMap>

    <sql id="selectNxpFacilityUserVo">
        select id, facility_id, user_id from nxp_facility_user
    </sql>

    <select id="selectNxpFacilityUserList" parameterType="NxpFacilityUser" resultMap="NxpFacilityUserResult">
        <include refid="selectNxpFacilityUserVo"/>
        <where>  
            <if test="facilityId != null "> and facility_id = #{facilityId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
        </where>
        order by facility_id asc
    </select>
    
    <select id="selectNxpFacilityUserById" parameterType="Long" resultMap="NxpFacilityUserResult">
        <include refid="selectNxpFacilityUserVo"/>
        where id = #{id}
    </select>
        

    <select id="selectNxpFacilityUserByFacilityId" parameterType="Long" resultMap="NxpFacilityUserResult">
        <include refid="selectNxpFacilityUserVo"/>
        where facility_id = #{facilityId}
    </select>

    <select id="selectNxpFacilityUserGroupByFacilityId" parameterType="NxpFacilityUser" resultMap="NxpFacilityUserResult">
        select facility_id from nxp_facility_user

        <if test="ids != null and ids.size > 0">
            where facility_id in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        group by facility_id
    </select>

    <insert id="insertNxpFacilityUser" parameterType="NxpFacilityUser" useGeneratedKeys="true" keyProperty="id">
        insert into [nxp_facility_user]
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="facilityId != null">facility_id,</if>
            <if test="userId != null">user_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="facilityId != null">#{facilityId},</if>
            <if test="userId != null">#{userId},</if>
         </trim>
    </insert>

    <update id="updateNxpFacilityUser" parameterType="NxpFacilityUser">
        update nxp_facility_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="facilityId != null">facility_id = #{facilityId},</if>
            <if test="userId != null">user_id = #{userId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpFacilityUserById" parameterType="Long">
        delete from nxp_facility_user where id = #{id}
    </delete>

    <delete id="deleteNxpFacilityUserByFacilityId" parameterType="Long">
        delete from nxp_facility_user where facility_id = #{facilityId}
    </delete>

    <delete id="deleteNxpFacilityUserByIds" parameterType="String">
        delete from nxp_facility_user where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>