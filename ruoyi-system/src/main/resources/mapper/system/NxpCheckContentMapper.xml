<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpCheckContentMapper">
    
    <resultMap type="NxpCheckContent" id="NxpCheckContentResult">
        <result property="id"    column="id"    />
        <result property="checkContent"    column="check_content"    />
        <result property="processId"    column="process_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="checkGroupId"    column="check_group_id"    />
    </resultMap>

    <sql id="selectNxpCheckContentVo">
        select id, check_content, process_id, create_time, update_time,check_group_id from nxp_check_content
    </sql>

    <select id="selectNxpCheckContentList" parameterType="NxpCheckContent" resultMap="NxpCheckContentResult">
        <include refid="selectNxpCheckContentVo"/>
        <where>  
            <if test="checkContent != null  and checkContent != ''"> and check_content = #{checkContent}</if>
            <if test="processId != null "> and process_id = #{processId}</if>
            <if test="checkGroupId != null "> and check_group_id = #{checkGroupId}</if>
        </where>
    </select>
    
    <select id="selectNxpCheckContentById" parameterType="Long" resultMap="NxpCheckContentResult">
        <include refid="selectNxpCheckContentVo"/>
        where id = #{id}
    </select>

    <select id="selectNxpCheckContentByCheckGroupId" parameterType="Long" resultMap="NxpCheckContentResult">
        <include refid="selectNxpCheckContentVo"/>
        where check_group_id = #{checkGroupId}
    </select>
        
    <insert id="insertNxpCheckContent" parameterType="NxpCheckContent" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_check_content
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="checkContent != null">check_content,</if>
            <if test="processId != null">process_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="checkGroupId != null">check_group_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="checkContent != null">#{checkContent},</if>
            <if test="processId != null">#{processId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="checkGroupId != null">#{checkGroupId},</if>
         </trim>
    </insert>

    <update id="updateNxpCheckContent" parameterType="NxpCheckContent">
        update nxp_check_content
        <trim prefix="SET" suffixOverrides=",">
            <if test="checkContent != null">check_content = #{checkContent},</if>
            <if test="processId != null">process_id = #{processId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="checkGroupId != null">check_group_id = #{checkGroupId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpCheckContentById" parameterType="Long">
        delete from nxp_check_content where id = #{id}
    </delete>

    <delete id="deleteNxpCheckContentByIds" parameterType="String">
        delete from nxp_check_content where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>