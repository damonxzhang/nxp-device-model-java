<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TobuyMapper">

    <resultMap type="Tobuy" id="TobuyResult">
        <result property="partID"    column="partID"    />
        <result property="description"    column="description"    />
        <result property="model"    column="model"    />
        <result property="userID"    column="userID"    />
        <result property="quantity"    column="quantity"    />
        <result property="vendor"    column="vendor"    />
    </resultMap>

    <sql id="selectTobuyVo">
        select partID, description, model, userID, quantity, vendor from BEPR.dbo.ToBuy
    </sql>

    <select id="selectTobuyList" parameterType="Tobuy" resultMap="TobuyResult">
        <include refid="selectTobuyVo"/>
        <where>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="model != null  and model != ''"> and model = #{model}</if>
            <if test="userID != null  and userID != ''"> and userID = #{userID}</if>
            <if test="quantity != null "> and quantity = #{quantity}</if>
            <if test="vendor != null  and vendor != ''"> and vendor = #{vendor}</if>
        </where>
    </select>

    <select id="selectTobuyById" parameterType="String" resultMap="TobuyResult">
        <include refid="selectTobuyVo"/>
        where partID = #{partID}
    </select>

    <insert id="insertTobuy" parameterType="Tobuy">
        insert into BEPR.dbo.ToBuy
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="partID != null">partID,</if>
            <if test="description != null">description,</if>
            <if test="model != null">model,</if>
            <if test="userID != null and userID != ''">userID,</if>
            <if test="quantity != null">quantity,</if>
            <if test="vendor != null and vendor != ''">vendor,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="partID != null">#{partID},</if>
            <if test="description != null">#{description},</if>
            <if test="model != null">#{model},</if>
            <if test="userID != null and userID != ''">#{userID},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="vendor != null and vendor != ''">#{vendor},</if>
         </trim>
    </insert>

    <update id="updateTobuy" parameterType="Tobuy">
        update tobuy
        <trim prefix="SET" suffixOverrides=",">
            <if test="description != null">description = #{description},</if>
            <if test="model != null">model = #{model},</if>
            <if test="userID != null and userID != ''">userID = #{userID},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="vendor != null and vendor != ''">vendor = #{vendor},</if>
        </trim>
        where partID = #{partID}
    </update>

    <delete id="deleteTobuyById" parameterType="String">
        delete from tobuy where partID = #{partID}
    </delete>

    <delete id="deleteTobuyByIds" parameterType="String">
        delete from tobuy where partID in
        <foreach item="partID" collection="array" open="(" separator="," close=")">
            #{partID}
        </foreach>
    </delete>

</mapper>