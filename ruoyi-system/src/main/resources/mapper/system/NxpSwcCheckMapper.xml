<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpSwcCheckMapper">
    
    <resultMap type="NxpSwcCheck" id="NxpSwcCheckResult">
        <result property="id"    column="id"    />
        <result property="checkedUserId"    column="checked_user_id"    />
        <result property="checkTime"    column="check_time"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="processId"    column="process_id"    />
        <result property="programGroupId"    column="program_group_id"    />
    </resultMap>

    <sql id="selectNxpSwcCheckVo">
        select id, checked_user_id, check_time, created_at, updated_at, process_id, program_group_id from nxp_swc_check
    </sql>

    <select id="selectNxpSwcCheckList" parameterType="NxpSwcCheck" resultMap="NxpSwcCheckResult">
        <include refid="selectNxpSwcCheckVo"/>
        <where>  
            <if test="checkedUserId != null "> and checked_user_id = #{checkedUserId}</if>
            <if test="checkTime != null "> and check_time = #{checkTime}</if>
            <if test="processId != null "> and process_id = #{processId}</if>
            <if test="programGroupId != null "> and program_group_id = #{programGroupId}</if>
        </where>
    </select>
    
    <select id="selectNxpSwcCheckById" parameterType="Long" resultMap="NxpSwcCheckResult">
        <include refid="selectNxpSwcCheckVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertNxpSwcCheck" parameterType="NxpSwcCheck">
        insert into nxp_swc_check
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="checkedUserId != null">checked_user_id,</if>
            <if test="checkTime != null">check_time,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="processId != null">process_id,</if>
            <if test="programGroupId != null">program_group_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="checkedUserId != null">#{checkedUserId},</if>
            <if test="checkTime != null">#{checkTime},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="processId != null">#{processId},</if>
            <if test="programGroupId != null">#{programGroupId},</if>
         </trim>
    </insert>

    <update id="updateNxpSwcCheck" parameterType="NxpSwcCheck">
        update nxp_swc_check
        <trim prefix="SET" suffixOverrides=",">
            <if test="checkedUserId != null">checked_user_id = #{checkedUserId},</if>
            <if test="checkTime != null">check_time = #{checkTime},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="processId != null">process_id = #{processId},</if>
            <if test="programGroupId != null">program_group_id = #{programGroupId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpSwcCheckById" parameterType="Long">
        delete from nxp_swc_check where id = #{id}
    </delete>

    <delete id="deleteNxpSwcCheckByIds" parameterType="String">
        delete from nxp_swc_check where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>