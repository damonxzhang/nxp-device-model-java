    <sql id="selectNxpInspectionServiceVo">
        select id, inspection_id, content_id, position_id, user_info_id, description, created_at, updated_at, service_time, file_id, status, facility_id, end_time,abort_reason_id,abort_reason_remark,maintenance_reason_id,maintenance_reason_name from nxp_inspection_service
    </sql>

    <select id="selectNxpInspectionServiceList" parameterType="NxpInspectionService" resultMap="NxpInspectionServiceResult">
        <include refid="selectNxpInspectionServiceVo"/>
        <where>  
            <if test="inspection_id != null "> and inspection_id = #{inspection_id}</if>
            <if test="content_id != null "> and content_id = #{content_id}</if>
            <if test="position_id != null "> and position_id = #{position_id}</if>
            <if test="user_info_id != null "> and user_info_id = #{user_info_id}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="created_at != null "> and created_at = #{created_at}</if>
            <if test="updated_at != null "> and updated_at = #{updated_at}</if>
            <if test="service_time != null "> and service_time = #{service_time}</if>
            <if test="file_id != null  and file_id != ''"> and file_id = #{file_id}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="facility_id != null "> and facility_id = #{facility_id}</if>
            <if test="end_time != null "> and end_time = #{end_time}</if>
            <if test="abort_reason_id != null "> and abort_reason_id = #{abort_reason_id}</if>
            <if test="abort_reason_remark != null "> and abort_reason_remark = #{abort_reason_remark}</if>
            <if test="maintenance_reason_id != null "> and maintenance_reason_id = #{maintenance_reason_id}</if>
            <if test="maintenance_reason_name != null "> and maintenance_reason_name = #{maintenance_reason_name}</if>
            <if test="repair_start_time != null and repair_start_time != '' and repair_end_time != null and repair_end_time != ''">and created_at between #{repair_start_time} and #{repair_end_time}</if>
        </where>
        order by service_time desc
    </select>
    

    <select id="selectNxpInspectionServiceListNew" parameterType="NxpInspectionService" resultMap="NxpInspectionServiceResult">
        SELECT
        nis.*,nf.head_user
        FROM
        nxp_inspection_service nis
        LEFT JOIN nxp_facility nf ON nis.facility_id = nf.id
        LEFT JOIN nxp_machine_process nmp ON nf.process = nmp.id
        <where>
            <if test="inspection_id != null "> and inspection_id = #{inspection_id}</if>
            <if test="process_id != null and process_id != '' "> and nmp.id = #{process_id}</if>
            <if test="content_id != null "> and content_id = #{content_id}</if>
            <if test="position_id != null "> and position_id = #{position_id}</if>
            <if test="user_info_id != null "> and user_info_id = #{user_info_id}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="service_time != null "> and service_time = #{service_time}</if>
            <if test="file_id != null  and file_id != ''"> and file_id = #{file_id}</if>
            <if test="status != null "> and nis.status = #{status}</if>
            <if test="facility_id != null "> and facility_id = #{facility_id}</if>
            <if test="end_time != null "> and end_time = #{end_time}</if>
            <if test="abort_reason_id != null "> and abort_reason_id = #{abort_reason_id}</if>
            <if test="abort_reason_remark != null "> and abort_reason_remark = #{abort_reason_remark}</if>
            <if test="maintenance_reason_id != null "> and maintenance_reason_id = #{maintenance_reason_id}</if>
            <if test="maintenance_reason_name != null "> and maintenance_reason_name = #{maintenance_reason_name}</if>
            <if test="params.repair_start_time != null and params.repair_start_time != '' and params.repair_end_time != null and params.repair_end_time != ''">and nis.service_time between #{params.repair_start_time} and #{params.repair_end_time}</if>
        </where>
        order by nis.id desc
    </select>

    <select id="selectNxpInspectionServiceById" parameterType="Long" resultMap="NxpInspectionServiceResult">
        <include refid="selectNxpInspectionServiceVo"/>
        where id = #{id}
    </select>

    <select id="selectNxpInspectionServiceByIds" parameterType="string" resultMap="NxpInspectionServiceResult">
        <include refid="selectNxpInspectionServiceVo"/>
        where id in
