<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.NxpMoldTypeMapper">
    
    <resultMap type="NxpMoldType" id="NxpMoldTypeResult">
        <result property="id"    column="id"    />
        <result property="moldTypeName"    column="mold_type_name"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="machineModel"    column="machine_model"    />
        <result property="moldType"    column="mold_type"    />
    </resultMap>

    <resultMap id="NxpMoldTypeNxpMoldTypeComponentResult" type="NxpMoldType" extends="NxpMoldTypeResult">
        <collection property="nxpMoldTypeComponentList" notNullColumn="mold_type_id" javaType="java.util.List" resultMap="NxpMoldTypeComponentResult" />
    </resultMap>

    <resultMap type="NxpMoldTypeComponent" id="NxpMoldTypeComponentResult">
        <result property="moldTypeId"    column="mold_type_id"    />
        <result property="componentName"    column="component_name"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="componentId"    column="component_id"    />
    </resultMap>

    <sql id="selectNxpMoldTypeVo">
        select id, mold_type_name, status, create_by, create_time, update_by, update_time, remark, machine_model, mold_type from nxp_mold_type
    </sql>

    <select id="selectNxpMoldTypeList" parameterType="NxpMoldType" resultMap="NxpMoldTypeResult">
        <include refid="selectNxpMoldTypeVo"/>
        <where>  
            <if test="moldTypeName != null  and moldTypeName != ''"> and mold_type_name like concat('%', #{moldTypeName}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="machineModel != null and machineModel != ''"> and CHARINDEX(#{machineModel}, machine_model) > 0</if>
            <if test="moldType != null "> and mold_type = #{moldType}</if>
        </where>
    </select>
    
    <select id="selectNxpMoldTypeById" parameterType="Long" resultMap="NxpMoldTypeNxpMoldTypeComponentResult">
        select a.id, a.mold_type_name, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark, a.machine_model, a.mold_type,
            b.mold_type_id, b.component_name, b.status, b.create_by, b.create_time, b.update_by, b.update_time, b.remark,b.component_id
        from nxp_mold_type a
        left join nxp_mold_type_component b on b.mold_type_id = a.id
        where a.id = #{id}
    </select>
        
    <insert id="insertNxpMoldType" parameterType="NxpMoldType" useGeneratedKeys="true" keyProperty="id">
        insert into nxp_mold_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="moldTypeName != null">mold_type_name,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="machineModel != null">machine_model,</if>
            <if test="moldType != null">mold_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="moldTypeName != null">#{moldTypeName},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="machineModel != null">#{machineModel},</if>
            <if test="moldType != null">#{moldType},</if>
         </trim>
    </insert>

    <update id="updateNxpMoldType" parameterType="NxpMoldType">
        update nxp_mold_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="moldTypeName != null">mold_type_name = #{moldTypeName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="machineModel != null">machine_model = #{machineModel},</if>
            <if test="moldType != null">mold_type = #{moldType},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNxpMoldTypeById" parameterType="Long">
        delete from nxp_mold_type where id = #{id}
    </delete>

    <delete id="deleteNxpMoldTypeByIds" parameterType="String">
        delete from nxp_mold_type where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteNxpMoldTypeComponentByMoldTypeIds" parameterType="String">
        delete from nxp_mold_type_component where mold_type_id in 
        <foreach item="moldTypeId" collection="array" open="(" separator="," close=")">
            #{moldTypeId}
        </foreach>
    </delete>

    <delete id="deleteNxpMoldTypeComponentByMoldTypeId" parameterType="Long">
        delete from nxp_mold_type_component where mold_type_id = #{moldTypeId}
    </delete>

    <insert id="batchNxpMoldTypeComponent">
        insert into nxp_mold_type_component( mold_type_id, component_name, status, create_by, create_time, update_by, update_time, remark) values
		<foreach item="item" index="index" collection="list" separator=",">
            ( #{item.moldTypeId}, #{item.componentName}, #{item.status}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark})
        </foreach>
    </insert>

    <update id="updateNxpMoldTypeComponent" parameterType="NxpMoldTypeComponent">
        update nxp_mold_type_component
        <trim prefix="SET" suffixOverrides=",">
            <if test="moldTypeId != null">mold_type_id = #{moldTypeId},</if>
            <if test="componentName != null and componentName != ''">component_name = #{componentName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </trim>
        where component_id = #{componentId}
    </update>

    <insert id="insertNxpMoldTypeComponent" parameterType="NxpMoldTypeComponent" useGeneratedKeys="true" keyProperty="componentId">
        insert into nxp_mold_type_component
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="moldTypeId != null">mold_type_id,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="componentName != null and componentName != ''">component_name,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="moldTypeId != null">#{moldTypeId},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="componentName != null and componentName != ''">#{componentName},</if>
        </trim>
    </insert>

    <select id="getByMoldTypeId" parameterType="NxpMoldTypeComponent" resultMap="NxpMoldTypeComponentResult">
        select mold_type_id, component_name, status, create_by, create_time, update_by, update_time, remark,component_id
        from nxp_mold_type_component
        <where>
            <if test="moldTypeId != null "> and mold_type_id = #{moldTypeId}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>

    <select id="getByComponentId" parameterType="Long" resultMap="NxpMoldTypeComponentResult">
        select mold_type_id, component_name, status, create_by, create_time, update_by, update_time, remark,component_id
        from nxp_mold_type_component
        where component_id = #{componentId}
    </select>

    <select id="selectNxpMoldTypeByMachineModel" parameterType="string" resultMap="NxpMoldTypeNxpMoldTypeComponentResult">
        select a.id, a.mold_type_name, a.status, a.create_by, a.create_time, a.update_by, a.update_time, a.remark, a.machine_model, a.mold_type,
            b.mold_type_id, b.component_name, b.status, b.create_by, b.create_time, b.update_by, b.update_time, b.remark,b.component_id
        from nxp_mold_type a
        left join nxp_mold_type_component b on b.mold_type_id = a.id
        CROSS APPLY STRING_SPLIT (a.machine_model, ',') AS machine_values
        where machine_values.value = #{machineModel}
        AND machine_values.value &lt;&gt; ''
    </select>
</mapper>